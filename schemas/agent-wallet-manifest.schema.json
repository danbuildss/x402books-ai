{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zettaai.co/schemas/agent-wallet-manifest.schema.json",
  "title": "Agent Wallet Manifest",
  "type": "object",
  "required": ["agent", "wallets"],
  "properties": {
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "ecosystem": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "wallets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["address", "role", "chain"],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "role": {
            "type": "string",
            "enum": ["treasury", "revenue", "fee", "operator", "deployer", "candidate"]
          },
          "chain": {
            "type": "string",
            "enum": ["base", "ethereum", "arbitrum", "optimism", "polygon", "solana", "other"]
          },
          "label": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
