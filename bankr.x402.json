            "transaction_count": { "type": "integer" },
            "transactions":      { "type": "array" }
          }
        }
      }
    },
    "agent-financial-state": {
      "description": "Agent-optimized financial snapshot — detects BANKR/Virtuals ecosystem membership, token portfolio, x402 payment count, and recent activity. Built for AI agents querying their own wallet.",
      "price": "0.05",
      "methods": ["GET"],
      "category": "agents",
      "tags": ["agents", "bankr", "virtuals", "x402", "portfolio", "base"],
      "schema": {
        "input": {
