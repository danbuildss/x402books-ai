        "output": {
          "type": "object",
          "properties": {
            "wallet":              { "type": "string" },
            "range":               { "type": "string" },
            "summary":             { "type": "object" },
            "report":              { "type": "object" },
            "categories":          { "type": "array" },
            "daily_flows":         { "type": "array" },
            "portfolio":           { "type": "array" },
            "top_counterparties":  { "type": "array" }
          }
        }
      }
    },
