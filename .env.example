# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# ── Alchemy (on-chain data) ───────────────────────────────────────────────────
ALCHEMY_API_KEY=your_alchemy_api_key

# ── OpenAI (Luca intelligence) ────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# ── Surplus inference proxy ───────────────────────────────────────────────────
# API key for the Surplus intelligence inference gateway.
# Set on Vercel/Zetta only — Hermes/VPS callers do NOT need this.
# Hermes calls the Zetta inference proxy using ZETTA_INTERNAL_SECRET instead.
SURPLUS_API_KEY=your_surplus_api_key

# ── LLM gateway (optional — overrides Anthropic direct) ──────────────────────
# Set these on Hermes if routing Luca inference through a custom gateway.
# LLM_BASE_URL defaults to Anthropic direct if unset.
LLM_API_KEY=your_llm_gateway_key
LLM_BASE_URL=https://your-llm-gateway/v1
LLM_MODEL=claude-sonnet-4-6

# ── Internal auth (required in production — rotate regularly) ─────────────────
# Used by crons, BANKR x402 handlers, and admin API routes.
# Generate with: openssl rand -hex 32
ZETTA_INTERNAL_SECRET=replace_with_random_64_char_hex

# ── Admin UI credentials ──────────────────────────────────────────────────────
LUCA_ADMIN_USER=admin
LUCA_ADMIN_PASSWORD=replace_with_strong_password

# ── Telegram bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Numeric chat ID to receive admin notifications (manifest submissions, etc.)
LUCA_ADMIN_CHAT_ID=your_admin_telegram_chat_id

# ── Session secrets ───────────────────────────────────────────────────────────
ACCESS_CODE_SALT=replace_with_random_secret_for_hashing_codes
ACCESS_SESSION_SECRET=replace_with_random_secret_for_signed_app_sessions
